<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoginDemo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LoginDemo.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <span class="navbar-brand">Learning Dashboard</span>

            <!-- LOGOUT BUTTON -->
            <a asp-controller="Account" asp-action="Login" class="btn btn-danger btn-sm">
                Logout
            </a>
        </div>
    </nav>

    <!-- MAIN LAYOUT -->
    <div class="container-fluid">
        <div class="row" style="margin-top:60px">

            <!-- LEFT SIDEBAR -->
            <!-- LEFT SIDEBAR -->
            <div class="col-2 bg-light vh-100 border-end">
                <h6 class="mt-3">Modules</h6>

                <ul class="list-group">

                    <!-- SQL MODULE -->
                    <li class="list-group-item fw-bold" onclick="toggleSQLMenu()" style="background-color: cadetblue !important;">
                        SQL Module ▼
                    </li>

                    <!-- DYNAMIC LIST -->
                    <div id="sqlSubMenu" class="list-group" style="display:none;"></div>

                    <!-- C# MODULE -->
                    <li class="list-group-item fw-bold" onclick="toggleSQLMenu()">
                        C# Module ▼
                    </li>
                </ul>
            </div>

            <!-- PAGE CONTENT -->
            <div class="col-10 p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        let isLoaded = false;

        function toggleSQLMenu() {
            let menu = document.getElementById("sqlSubMenu");

            // Toggle show/hide
            if (menu.style.display === "none") {
                menu.style.display = "block";

                // Load only first time
                if (!isLoaded) {
                    loadTopics();
                    isLoaded = true;
                }
            } else {
                menu.style.display = "none";
            }
        }

        function loadTopics() {
            fetch('/Module/GetTopics')
                .then(res => res.json())
                .then(data => {

                    let menu = document.getElementById("sqlSubMenu");
                    menu.innerHTML = "";

                    data.forEach(topic => {

                        let item = document.createElement("li");
                        item.className = "list-group-item";
                        item.innerText = formatText(topic);

                        // click event (load content)
                        item.onclick = function () {
                            loadTopic(topic);
                        };

                        menu.appendChild(item);
                    });

                });
        }

        // Format text (SQLBasics → SQL Basics)
        function formatText(text) {
            return text.replace(/([A-Z])/g, ' $1').trim();
        }

    </script>
    <script>
        function loadTopic(topicName) {

            let box = document.getElementById("sqlBox");

            // ✅ If NOT on SqlTopic page → redirect ONCE
            if (!box) {
                window.location.href = '/Module/SqlTopic?topic=' + topicName;
                return;
            }

            // ✅ If already on page → just load data
            fetch('/Module/GetSqlTopic?topic=' + topicName)
                .then(response => response.json())
                .then(data => {
                    box.value = data;
                })
                .catch(err => console.log(err));
        }

        // Replace old functions
        function showSQLBasics() {
            loadTopic('SQLBasics');
        }

        function showCRUD() {
            loadTopic('CRUD');
        }

        function showJoins() {
            loadTopic('Joins');
        }

        function showFunctions() {
            loadTopic('Functions');
        }

        function showProcedures() {
            loadTopic('Procedures');
        }

    </script>
</body>

</html>
