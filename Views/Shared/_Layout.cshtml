        function loadTopics(language, menuId) {

            fetch('/Module/GetTopics?language=' +
                encodeURIComponent(language))

                .then(res => res.json())

                .then(data => {

                    let menu = document.getElementById(menuId);

                    menu.innerHTML = "";

                    if (data.length === 0) {

                        menu.innerHTML =
                            "<li class='list-group-item'>No Topics Found</li>";

                        return;
                    }

                    data.forEach(topic => {

                        // Parent Topic
                        let item = document.createElement("li");

                        item.className = "list-group-item";
                        item.style.cursor = "pointer";

                        item.innerText = topic;

                        // Subtopic container INSIDE parent
                        let subMenu = document.createElement("ul");

                        subMenu.className = "list-group";
                        subMenu.style.display = "none";
                        subMenu.style.paddingLeft = "20px";

                        // Parent click
                        item.onclick = function (event) {

                            event.stopPropagation();

                            if (language === "C#") {

                                // Load subtopics
                                loadCSharpSubTopics(
                                    topic,
                                    subMenu
                                );

                            } else {

                                loadTopic(topic, language);
                            }
                        };

                        // Put subMenu inside parent
                        item.appendChild(subMenu);

                        menu.appendChild(item);
                    });

                })
                .catch(err => console.error("Error:", err));
        }

        // Format text (SQLBasics → SQL Basics)
        function formatText(text) {
            return text.replace(/([A-Z])/g, ' $1').trim();
        }

