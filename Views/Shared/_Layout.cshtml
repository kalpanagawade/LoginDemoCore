        function loadCSharpSubTopics(topicName, subMenu) {

            // If already loaded, just open/close
            if (subMenu.getAttribute("data-loaded") === "true") {

                if (subMenu.style.display === "none") {
                    subMenu.style.display = "block";
                } else {
                    subMenu.style.display = "none";
                }

                return;
            }

            fetch('/Module/GetCSharpSubTopics?topicName=' +
                encodeURIComponent(topicName))

                .then(response => response.json())

                .then(data => {

                    subMenu.innerHTML = "";

                    if (data.length === 0) {

                        loadTopic(topicName, "C#");

                        return;
                    }

                    data.forEach(subTopic => {

                        let subItem =
                            document.createElement("li");

                        subItem.className =
                            "list-group-item";

                        subItem.innerText =
                            "↳ " + subTopic;

                        subItem.style.cursor =
                            "pointer";

                        // Subtopic click
                        subItem.onclick =
                            function (event) {

                                event.stopPropagation();

                                loadTopic(
                                    subTopic,
                                    "C#"
                                );
                            };

                        subMenu.appendChild(subItem);
                    });

                    // Mark as loaded
                    subMenu.setAttribute(
                        "data-loaded",
                        "true"
                    );

                    // Open subtopics
                    subMenu.style.display = "block";

                })

                .catch(err =>
                    console.error(
                        "C# Sub Topic Error:",
                        err
                    )
                );
        }

