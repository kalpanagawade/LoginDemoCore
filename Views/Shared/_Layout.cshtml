         function loadTopic(topicName, language) {

            if (language === "SQL") {

                let box =
                    document.getElementById("sqlBox");

                if (!box) {

                    window.location.href =
                        '/Module/SqlTopic?topic=' +
                        encodeURIComponent(topicName);

                    return;
                }

                fetch('/Module/GetSqlTopic?topic=' +
                    encodeURIComponent(topicName))

                    .then(response => response.json())

                    .then(data => {
                        box.value = data;
                    })

                    .catch(err =>
                        console.log(err)
                    );
            }

            else if (language === "C#") {

                window.location.href =
                    '/Module/CSharpTopic?topic=' +
                    encodeURIComponent(topicName);
            }
        }

