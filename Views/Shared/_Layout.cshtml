        document.addEventListener("DOMContentLoaded", function () {

            let parentTopic =
                sessionStorage.getItem("CSharpParentTopic");

            if (parentTopic) {

                // Open C# submenu
                let menu =
                    document.getElementById("cSubMenu");

                menu.style.display = "block";

                // Load C# parent topics if required
                if (!isLoadedC) {

                    loadTopics("C#", "cSubMenu");

                    isLoadedC = true;
                }

                // Load child topics
