<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoginDemo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LoginDemo.styles.css" asp-append-version="true" />
    <style>
        #sidebarWrapper, #miniSidebar, #mainContent {
            transition: all 0.3s ease;
        }
    </style>
</head>
<body>
    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <span class="navbar-brand">Learning Dashboard</span>

            <!-- LOGOUT BUTTON -->
            <a asp-controller="Account" asp-action="Login" class="btn btn-danger btn-sm">
                Logout
            </a>
        </div>
    </nav>

    <!-- MAIN LAYOUT -->
    <div class="container-fluid">
        <div class="row" style="margin-top:60px">

            <!-- ✅ SIDEBAR -->
            <div id="sidebarWrapper" class="col-2 bg-light vh-100 border-end position-relative">

                <!-- HEADER -->
                <div class="d-flex justify-content-between align-items-center p-2">
                    <h6 class="mt-2 mb-0">Modules</h6>

                    <!-- MINUS BUTTON -->
                    <button onclick="closeSidebar()" class="btn btn-sm btn-danger" style="width: 14%;">−</button>
                </div>

                <ul class="list-group">

                    <!-- SQL MODULE -->
                    <li class="list-group-item fw-bold"
                        onclick="toggleSQLMenu()"
                        style="background-color: cadetblue; cursor:pointer;">
                        SQL Module ▼
                    </li>

                    <div id="sqlSubMenu" class="list-group" style="display:none;"></div>

                    <!-- C# MODULE -->
                    <li class="list-group-item fw-bold"
                        onclick="togglecMenu()"
                        style="background-color: antiquewhite; cursor:pointer;">
                        C# Module ▼
                    </li>

                    <div id="cSubMenu" class="list-group" style="display:none;"></div>

                </ul>
            </div>

            <!-- ✅ COLLAPSED VERTICAL TAB -->
            <div id="miniSidebar" class="col-1"
                 style="display:none; background:#343a40; color:white; cursor:pointer;width: 1%;"
                 onclick="openSidebar()">

                <div class="d-flex align-items-center justify-content-center vh-100">
                    <span style="writing-mode: vertical-rl; transform: rotate(180deg);">
                        Modules
                    </span>
                </div>
            </div>

            <!-- ✅ MAIN CONTENT -->
            <div id="mainContent" class="col p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        function toggleSQLMenu() {
            let menu = document.getElementById("sqlSubMenu");

            if (menu.style.display === "none") {
                menu.style.display = "block";

                if (!isLoadedSQL) {
                    loadTopics("SQL", "sqlSubMenu");
                    isLoadedSQL = true;
                }
            } else {
                menu.style.display = "none";
            }
        }

        function togglecMenu() {
            let menu = document.getElementById("cSubMenu");

            if (menu.style.display === "none") {
                menu.style.display = "block";

                if (!isLoadedC) {
                    loadTopics("C#", "cSubMenu");
                    isLoadedC = true;
                }
            } else {
                menu.style.display = "none";
            }
        }

        let isLoadedSQL = false;
        let isLoadedC = false;

        // 🔹 Common function (Dynamic)
        function loadTopics(language, menuId) {
            debugger;

            console.log("Calling API:", language);

            fetch('/Module/GetTopics?language=' + encodeURIComponent(language))
                .then(res => res.json())
                .then(data => {

                    console.log("Data:", data);

                    let menu = document.getElementById(menuId);
                    menu.innerHTML = "";

                    if (data.length === 0) {
                        menu.innerHTML = "<li class='list-group-item'>No Topics Found</li>";
                        return;
                    }

                    data.forEach(topic => {

                        let item = document.createElement("li");
                        item.className = "list-group-item";
                        item.innerText = topic;

                        item.onclick = function () {
                            //loadTopic(topic); // your existing function
                            loadTopic(topic, language);
                        };

                        menu.appendChild(item);
                    });

                })
                .catch(err => console.error("Error:", err));
        }

        // Format text (SQLBasics → SQL Basics)
        function formatText(text) {
            return text.replace(/([A-Z])/g, ' $1').trim();
        }

    </script>
    <script>
        function closeSidebar() {

            document.getElementById("sidebarWrapper").style.display = "none";
            document.getElementById("miniSidebar").style.display = "block";

        }

        function openSidebar() {

            document.getElementById("sidebarWrapper").style.display = "block";
            document.getElementById("miniSidebar").style.display = "none";

        }

        // function loadTopic(topicName) {
        //     debugger;

        //     let box = document.getElementById("sqlBox");

        //     // ✅ If NOT on SqlTopic page → redirect ONCE
        //     if (!box) {
        //         window.location.href = '/Module/SqlTopic?topic=' + topicName;
        //         return;
        //     }

        //     // ✅ If already on page → just load data
        //     fetch('/Module/GetSqlTopic?topic=' + topicName)
        //         .then(response => response.json())
        //         .then(data => {
        //             box.value = data;
        //         })
        //         .catch(err => console.log(err));
        // }

        function loadTopic(topicName, language) {

            if (language === "SQL") 
            {

                let box = document.getElementById("sqlBox");

                if (!box) {

                    window.location.href =
                        '/Module/SqlTopic?topic=' +
                        encodeURIComponent(topicName);

                    return;
                }

                fetch('/Module/GetSqlTopic?topic=' +
                    encodeURIComponent(topicName))

                    .then(response => response.json())

                    .then(data => {
                        box.value = data;
                    })

                    .catch(err => console.log(err));

            }
            else if (language === "C#") {

                window.location.href =
                    '/Module/CSharpTopic?topic=' +
                    encodeURIComponent(topicName);
            }
        }

        // Replace old functions
        // function showSQLBasics() {
        //     loadTopic('SQLBasics');
        // }

        // function showCRUD() {
        //     loadTopic('CRUD');
        // }

        // function showJoins() {
        //     loadTopic('Joins');
        // }

        // function showFunctions() {
        //     loadTopic('Functions');
        // }

        // function showProcedures() {
        //     loadTopic('Procedures');
        // }

    </script>
</body>

</html>
